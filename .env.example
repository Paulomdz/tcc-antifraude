# Copie este arquivo para ".env" (que já está no .gitignore) e preencha com
# sua própria chave para ativar o Agente Juiz real via CrewAI + Google Gemini.
# Sem essa chave configurada, o sistema funciona normalmente usando a regra
# determinística de decisão como fallback automático (ver src/ferramentas/ferramentas_crewai.py).

# Chave de API do Google AI Studio / Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Modelo Gemini usado pelo Agente Juiz (opcional; padrão: gemini-2.5-flash).
# Ajuste aqui se a Google descontinuar/renomear o modelo no futuro, sem
# precisar alterar código.
GEMINI_MODEL=gemini-2.5-flash
